# Vale reads the styles from the Nix store through VALE_STYLES_PATH.
# Everything under .vale/styles except the tracked config vocabularies is a
# leftover, for example of `vale sync`, and must not be committed.
.vale/styles/*
!.vale/styles/config/

# Cache of lychee.
.lycheecache

# The dev shell links the Git hook configuration here. The link points into
# the Nix store, and the shell writes it again when the configuration changes.
.pre-commit-config.yaml
